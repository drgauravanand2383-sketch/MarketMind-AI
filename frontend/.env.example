# MarketMind AI Frontend — Environment Configuration
# Copy this file to .env and adjust for your environment. Never commit .env.
#
# Both variables below are read at BUILD time (`npm run build` / the
# Docker image build), not at container-start time — Vite compiles them
# directly into the static JS bundle. In dev mode (`npm run dev`), both
# fall back to the local backend dev server shown here if unset. In a
# production build, an unset or malformed value throws a clear error the
# moment the page loads in the browser, rather than silently shipping a
# broken deployment — see src/services/api/config.ts and
# docs/release/PRODUCTION_CONFIGURATION_GUIDE.md's Frontend section.

# Base URL of the backend's /api/v1 REST API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL of the backend's /ws WebSocket endpoint.
VITE_WS_BASE_URL=ws://localhost:8000/ws
