# ==============================================================================
# MarketMind AI — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=MarketMind AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000

# --- Security ---
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# --- Authentication & Authorization Framework (Sprint 56) ---
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_CLOCK_SKEW_TOLERANCE_SECONDS=30

# --- Security Response Headers (Sprint 60) ---
# CSP and HSTS default to disabled: a strict CSP would break /docs and
# /redoc unless tuned for your own asset hosting, and HSTS is actively
# wrong to send from a server not behind TLS. Enable both only once the
# deployment is served over HTTPS.
SECURITY_HEADERS_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_HEADERS_X_FRAME_OPTIONS=DENY
SECURITY_HEADERS_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HEADERS_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
# SECURITY_HEADERS_CONTENT_SECURITY_POLICY=default-src 'self'
SECURITY_HEADERS_HSTS_ENABLED=false
SECURITY_HEADERS_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true

# --- PostgreSQL ---
POSTGRES_USER=marketmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://marketmind:change-me@localhost:5432/marketmind

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/cache/chroma

# --- Claude API ---
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-5

# ==============================================================================
# Market Intelligence Ingestion (Milestone 11 — post-v1.0, not part of the
# frozen v1.0.0 release). See docs/architecture/MARKET_INTELLIGENCE_INGESTION.md
# for the full design. Every setting below has a safe default — none are
# required to run the rest of the application.
# ==============================================================================

# --- RSS feed sources ---
# JSON array of RSS/Atom feed sources to ingest — empty by default
# ("nothing to collect", not an error). Must be valid JSON. Each element
# is either a bare URL string:
#   RSS_FEED_URLS=["https://example.com/feed.xml"]
# or an object carrying optional provenance metadata (v1.2 Priority 6) —
# name/category/tag are recorded on every ingested record but never
# affect fetching/matching:
#   RSS_FEED_URLS=[{"url":"https://example.com/feed.xml","name":"Example Markets","category":"Markets"}]
# The two forms can be mixed in the same array. See
# docs/architecture/MARKET_INTELLIGENCE_INGESTION.md §13 for a real,
# verified example source set (Nasdaq category feeds + company IR feeds).
# Only add feed URLs you trust: their content is treated as untrusted input
# (never executed, never rendered as HTML) but is still ingested as-is.
RSS_FEED_URLS=[]
RSS_USER_AGENT=MarketMind-AI/1.0
RSS_FEED_TIMEOUT_SECONDS=10.0
# Retries apply per feed URL, isolated from every other configured feed.
RSS_RETRY_ATTEMPTS=1
RSS_RETRY_BACKOFF_SECONDS=1.0

# --- Ingestion schedule ---
# Explicit opt-in: false by default so upgrading an existing deployment
# never silently starts a new periodic background job. Sets both whether
# the pipeline fires automatically on INGESTION_INTERVAL_SECONDS *and*
# whether the manual "run now" trigger (scripts/run_ingestion.py) can run
# at all — Scheduler's own contract disables both together, not separately.
INGESTION_ENABLED=false
INGESTION_INTERVAL_SECONDS=3600.0

# --- Embedding provider ---
# Selects the concrete BaseEmbeddingProvider MorningPipeline uses — never
# hardcoded into the pipeline itself. Only "local" is implemented today:
# a real, local, CPU-only sentence-transformer model (already bundled with
# the existing chromadb dependency) — no external API key, no new external
# service. EMBEDDING_MODEL is informational (records which model is
# actually in use); changing it does not select a different model.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==============================================================================
# Entity Resolution & Company Intelligence (Milestone 12 — post-v1.0/v1.1
# candidate, not part of the frozen v1.0.0 release). See
# docs/architecture/ENTITY_RESOLUTION.md for the full design. Every
# setting below has a safe default — none are required to run the rest of
# the application, and no secret is required (deterministic, local
# reference-set matching only — no external API call).
# ==============================================================================

# Unlike INGESTION_ENABLED above, this defaults to true: resolution is a
# pure, deterministic, in-process metadata enrichment step — it starts no
# new scheduled job and calls no external service, so there is no
# "upgrading silently changes runtime behavior" concern to guard against.
# Set to false to keep the pre-Milestone-12 behavior (every ingested
# record recorded as entity_resolved=false).
ENTITY_RESOLUTION_ENABLED=true
# Minimum score (0.0-1.0) for a resolution to be trusted enough to attach
# automatically. Must be >= ENTITY_MATCH_MEDIUM_THRESHOLD.
ENTITY_MATCH_HIGH_THRESHOLD=0.85
# Minimum score for a resolution to be attached at all (flagged for
# review — see docs/architecture/ENTITY_RESOLUTION.md §6). Below this,
# the article is retained but not associated with any company.
ENTITY_MATCH_MEDIUM_THRESHOLD=0.5
# Maximum number of candidate entities returned per resolution (primary +
# secondary combined).
ENTITY_MAX_CANDIDATES=5
# Optional path to a JSON file of *additional* real canonical companies —
# validated (collision + alias-governance checks) and merged into the
# base reference set at startup. Unset (the default) = no overlay, zero
# behavior change. See docs/architecture/ENTITY_RESOLUTION.md §15.
# CANONICAL_ENTITIES_OVERLAY_PATH=

# ==============================================================================
# Live Market Data & Price Intelligence (Milestone 13 — post-v1.0/v1.1
# candidate, not part of the frozen v1.0.0 release). See
# docs/architecture/MARKET_DATA_ARCHITECTURE.md for the full design.
# ==============================================================================

# Selects the concrete MarketDataProvider — never hardcoded into any
# caller. "mock" (the default) preserves every pre-Milestone-13 behavior
# exactly (MockMarketDataProvider, no network call ever made).
# "yahoo_finance" selects the real provider (Yahoo Finance's public chart
# endpoint) — no API key/signup required, but it IS a new outbound network
# call surface, so — unlike ENTITY_RESOLUTION_ENABLED — this defaults to
# the safe/inert option rather than opting an existing deployment into
# live requests silently.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_TIMEOUT_SECONDS=10.0
# Retries apply per quote request, the same retry-with-backoff technique
# RSS_RETRY_ATTEMPTS/RSS_RETRY_BACKOFF_SECONDS already use.
MARKET_DATA_RETRY_ATTEMPTS=1
MARKET_DATA_RETRY_BACKOFF_SECONDS=1.0
# How long a fetched quote is served from cache before being considered
# stale (seconds). Applies regardless of which provider is selected.
MARKET_DATA_CACHE_TTL_SECONDS=60.0

# --- Scheduled refresh ---
# Explicit opt-in, same reasoning as INGESTION_ENABLED: false by default
# so upgrading an existing deployment never silently starts a new
# periodic background job. Independent of MARKET_DATA_PROVIDER — the real
# provider can be used for on-demand/Research lookups without enabling
# the scheduled refresh, or vice versa.
MARKET_DATA_ENABLED=false
MARKET_DATA_REFRESH_INTERVAL_SECONDS=3600.0

# --- Global Market Intelligence ---
# Explicit opt-in, same reasoning as MARKET_DATA_ENABLED/INGESTION_ENABLED:
# false by default so upgrading an existing deployment never silently
# starts a new daily scheduled job that calls external market-data/LLM
# providers. The master scheduler fires once daily; GLOBAL_MARKETS_REPORT_
# CRON/_TIMEZONE are evaluated in the given timezone, never the
# container's own local/system timezone.
GLOBAL_MARKETS_ENABLED=false
GLOBAL_MARKETS_REPORT_CRON="30 8 * * *"
GLOBAL_MARKETS_REPORT_TIMEZONE=Asia/Kolkata
# Populates the four penny/micro-cap categories' candidate universes via
# live discovery — Yahoo Finance's unofficial screener endpoint (equities)
# and CoinGecko's public API (crypto), both no-API-key. Separately gated
# from GLOBAL_MARKETS_ENABLED (an operator can run the five main
# categories without opting into penny/micro-cap discovery, or vice
# versa) — false by default, since both vendors here are external,
# unofficial-or-undocumented-in-part dependencies an operator should opt
# into deliberately.
GLOBAL_MARKET_SCREENING_ENABLED=false
