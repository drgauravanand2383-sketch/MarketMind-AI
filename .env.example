# ==============================================================================
# MarketMind AI — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=MarketMind AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000

# --- Security ---
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# --- Authentication & Authorization Framework (Sprint 56) ---
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_CLOCK_SKEW_TOLERANCE_SECONDS=30

# --- Security Response Headers (Sprint 60) ---
# CSP and HSTS default to disabled: a strict CSP would break /docs and
# /redoc unless tuned for your own asset hosting, and HSTS is actively
# wrong to send from a server not behind TLS. Enable both only once the
# deployment is served over HTTPS.
SECURITY_HEADERS_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_HEADERS_X_FRAME_OPTIONS=DENY
SECURITY_HEADERS_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HEADERS_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
# SECURITY_HEADERS_CONTENT_SECURITY_POLICY=default-src 'self'
SECURITY_HEADERS_HSTS_ENABLED=false
SECURITY_HEADERS_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true

# --- PostgreSQL ---
POSTGRES_USER=marketmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://marketmind:change-me@localhost:5432/marketmind

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/cache/chroma

# --- Claude API ---
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-5
